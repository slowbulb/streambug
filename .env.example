DATABASE_URL="postgresql://user:password@localhost:5432/audio_console?schema=public"

# Optional: only needed when DATABASE_URL points at a connection pooler (e.g.
# Supabase's Supavisor/PgBouncer). Migrations need a direct, non-pooled
# connection; runtime queries use the pooled DATABASE_URL. Leave unset for a
# plain non-pooled Postgres (e.g. local dev) - it falls back to DATABASE_URL.
DIRECT_URL=""

# Required in production (e.g. Vercel): stores uploaded audio/cover files.
# Create a Blob store in your Vercel project (Storage tab) and copy its
# read-write token here. Without it, uploads are written to public/uploads
# on local disk instead - fine for local dev, but that disk is ephemeral on
# most serverless hosts, so files won't survive a redeploy.
BLOB_READ_WRITE_TOKEN=""

# Required: the password for the single owner account. Anyone without it can
# browse and play but not upload, edit, or reorganize anything - see the
# "Authentication" section of the README.
OWNER_PASSWORD=""

# Required: a random secret used to sign session cookies. Generate one with
# `openssl rand -base64 32` (or similar) - changing it invalidates all
# existing sessions.
SESSION_SECRET=""
